# Copy to backend/.env and fill in. Real environment variables win over this file.

APP_ENV=development

# Hosted PostgreSQL (Neon, Supabase, Render, Railway, Aiven ...). Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DB_POOL_MAX=10

# Optional Redis cache (Redis Cloud / Upstash: rediss://default:PASSWORD@HOST:PORT). Leave empty to disable.
REDIS_URL=
FEED_CACHE_SECONDS=60

# Long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12

# Sign-ups from these domains are verified automatically (comma separated).
COLLEGE_EMAIL_DOMAINS=thapar.edu

# The Next.js app's address(es), comma separated.
CORS_ORIGINS=http://localhost:3000

ORDER_REQUEST_TTL_HOURS=48
EXPIRE_JOB_SECONDS=60

# Photos: set CLOUDINARY_URL (Dashboard -> API Keys -> "API environment variable") to use Cloudinary.
# Leave it empty to store photos in UPLOAD_DIR and serve them from PUBLIC_BASE_URL/uploads.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=hostel_market
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=5

# Tests only: a SEPARATE, empty database. The test suite drops and recreates every table in it.
TEST_DATABASE_URL=
