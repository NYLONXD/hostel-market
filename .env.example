# Copy to .env and adjust. Real environment variables always win over this file.
# Keep comments on their own lines: make (which also reads this file) would treat
# the spaces before an inline comment as part of the value.

# development | production | test
APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
# debug | info | warn | error
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s
# Run the asynq worker + scheduler in this process.
RUN_WORKERS=true
# Use X-Forwarded-For / X-Real-IP as the client IP. Enable ONLY behind a proxy that
# overwrites these headers; otherwise clients can spoof IPs to dodge rate limits.
TRUST_PROXY_HEADERS=false

# --- Postgres -----------------------------------------------------------------
DATABASE_URL_PRIMARY=postgres://hostel:hostel@localhost:5432/hostel_market?sslmode=disable
# Leave empty to send every read to the primary (single-Postgres local dev).
DATABASE_URL_REPLICA=
DB_MAX_CONNS=20

# --- Redis --------------------------------------------------------------------
# Local: redis://localhost:6379/0
# Redis Cloud (TLS): rediss://default:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379/0
# Connections per process. Hosted plans cap total connections (Redis Cloud free: 30),
# so keep REDIS_POOL_SIZE + WORKER_CONCURRENCY + a few well under your plan's limit.
REDIS_POOL_SIZE=10
# Background jobs processed concurrently (auction close, payment expiry, media cleanup).
WORKER_CONCURRENCY=4

# --- Auth ---------------------------------------------------------------------
# Each must be >= 32 bytes and they must differ. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-bytes
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_ISSUER=hostelmarket
# Comma-separated; registrations from these domains are auto-verified.
COLLEGE_EMAIL_DOMAINS=example.ac.in

# --- Marketplace rules --------------------------------------------------------
# Percent of the final auction price; up to 2 decimals, e.g. 12.5
PLATFORM_FEE_PERCENT=20
AUCTION_PAYMENT_DEADLINE=30m
# Extra time allowed for a payment that is already pending verification.
PAYMENT_PENDING_GRACE=30m
ANTI_SNIPE_WINDOW=30s
ANTI_SNIPE_EXTENSION=60s
# Unanswered fixed-price purchase requests expire after this.
ORDER_REQUEST_TTL=48h
# Unpaid auction wins before a user is blocked from bidding.
MAX_PAYMENT_DEFAULTS=2

# --- Caching / replication lag ------------------------------------------------
RECENT_WRITE_TTL=10s
FEED_CACHE_TTL=30s

# --- Rate limits: <requests>/<window> -----------------------------------------
# GLOBAL is per user (per IP when anonymous); LOGIN is per email+IP; REGISTER is per
# IP (keep it generous: a hostel often shares one NAT IP); BID/MESSAGE are per user.
RATE_LIMIT_GLOBAL=120/1m
RATE_LIMIT_LOGIN=5/15m
RATE_LIMIT_REGISTER=20/1h
RATE_LIMIT_BID=20/1m
RATE_LIMIT_MESSAGE=30/1m

# --- Cloudinary (optional in development, required in production) -------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hostel_market

# --- Payments -----------------------------------------------------------------
# mock | upi_link
PAYMENT_PROVIDER=mock
# Required for upi_link, e.g. hostelmarket@okaxis
PLATFORM_UPI_ID=
PLATFORM_UPI_NAME=Hostel Market
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret

# --- Tests --------------------------------------------------------------------
# Integration tests are skipped unless these are set. Use a SEPARATE database:
# integration tests truncate tables.
TEST_DATABASE_URL=
TEST_REDIS_URL=
